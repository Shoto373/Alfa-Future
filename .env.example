# Переменные окружения (секретов в репозитории нет). Скопируйте в .env и заполните.

# PostgreSQL: локальный Docker имеет пароль alfa-local по умолчанию.
# Для production задайте отдельный пароль. Произвольные символы поддерживаются через PG*.
# POSTGRES_PASSWORD=replace-with-a-private-password
# DATABASE_URL=postgresql://alfa:alfa-local@127.0.0.1:5432/alfa
# POSTGRES_PORT=5432
# API_PORT=8000
# WEB_PORT=3000

# Production (docker-compose.yml): публичный адрес сайта — для CORS и сборки frontend.
# PUBLIC_ORIGIN=https://pointers-team.online
# Теги образов BACKEND_IMAGE и FRONTEND_IMAGE в production задает release.env агента автодеплоя (deploy/gitops).

# --- LLM (только модели из Приложения 3 кейса). Без ключа агент работает в режиме правил.
LLM_BASE_URL=
LLM_API_KEY=
# Адрес из инструкции организаторов: https://changellenge.up.railway.app/v1 (запасной: https://api.alfahack-gateway26.ru/v1)
LLM_MODEL_COMPOSE=deepseek/deepseek-v4.1-flash
LLM_MODEL_PLAN=z-ai/glm-5.3-flash
LLM_MODEL_REVIEW=z-ai/glm-5.3-flash
LLM_MODEL_QA=deepseek/deepseek-v4.1-flash
# reasoning_effort передается только этим моделям (GLM без него тратит лимит на рассуждения)
LLM_REASONING_EFFORT_MODELS=glm
LLM_DAILY_TOKEN_LIMIT=2000000
LLM_DAILY_COST_LIMIT=450
LLM_REASONING_EFFORT=low
LLM_FALLBACK_BASE_URL=https://api.alfahack-gateway26.ru/v1
# Тайм-аут одного запроса к модели, секунд.
# LLM_TIMEOUT_SECONDS=75
# Цены моделей для резерва бюджета, ₽ за 1000 токенов (по фрагменту имени; по умолчанию — оценка сверху в config.py).
# LLM_PRICES=deepseek=0.06,glm=0.04

# --- Данные кейса (пути на хосте). По умолчанию — синтетический набор из data/synthetic.
# CASE_DATA_DIR=./data
# BANK_PDF_HOST_DIR=./data/materials/an

# --- Новости: RSS (имя|url через запятую) и автоматический конвейер (app/pipeline.py):
# каждые RSS_REFRESH_MINUTES минут — сбор новостей и их разбор для привязанных компаний (0 — выключен).
# RSS_SOURCES=Банк России|https://www.cbr.ru/rss/eventrss,Интерфакс|https://www.interfax.ru/rss.asp
# Сколько последних записей брать из каждой ленты за один опрос.
# RSS_MAX_ITEMS=30
RSS_REFRESH_MINUTES=15
# Разборов на правилах на пару «компания — роль» за цикл; AI-версий за цикл; доля дневного лимита LLM для конвейера.
# PIPELINE_RULES_TOP=10
# PIPELINE_LLM_PER_CYCLE=5
# PIPELINE_LLM_SHARE=0.5
# Задержка первого цикла после старта, секунд: сначала сервис отвечает пользователям.
# PIPELINE_START_DELAY_SECONDS=15
# В production Compose (docker-compose.yml) конвейер по умолчанию выключен (0) до релиза.
# Сколько новых сюжетов (3+ сообщения об одном событии) конвейер называет моделью за цикл.
# PIPELINE_STORY_LABELS=5
# Полный текст статьи по ссылке из RSS (1) или только анонс ленты (0).
# RSS_FULL_TEXT=1
# Модель-классификатор для неуверенных новостей: выключена (на эталоне добавляла шум), включение — 1.
# CLASSIFY_LLM=0
# LLM_MODEL_CLASSIFY=google/gemma-4-26b-a4b-it

# --- Ежедневный отчет о качестве в Telegram (app/quality.py): уходит из конвейера раз в сутки
# после QUALITY_REPORT_HOUR_UTC (6 UTC = 9:00 МСК), если заданы токен бота и чат. Не коммитить токен.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# QUALITY_REPORT_HOUR_UTC=6

# --- Смысловой поиск: локальная embedding-модель (не LLM). 0 — только словари и BM25.
EMBEDDINGS_ENABLED=1
# EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Сколько текстов модель обрабатывает за один проход (больше — быстрее, но больше памяти).
# EMBEDDINGS_BATCH_SIZE=32
# Векторы хранятся в PostgreSQL (pgvector, таблица vector_items); 0 — только в памяти процесса.
# EMBEDDINGS_PERSIST=1

# --- Кэш: Redis (в Docker задается автоматически). Без адреса — кэш в памяти процесса.
# REDIS_URL=redis://127.0.0.1:6379/0
# FEED_CACHE_SECONDS=300
# Готовые ленты привязанных компаний считаются при старте (0 — по первому запросу).
# WARM_FEEDS_ON_START=1

# --- Прочее
FRONTEND_ORIGIN=http://localhost:3000
ANALYSIS_TIMEOUT_SECONDS=150
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
