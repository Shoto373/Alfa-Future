# Переменные окружения (секретов в репозитории нет). Скопируйте в .env и заполните.

# --- LLM (только модели из Приложения 3 кейса). Без ключа агент работает в режиме правил.
LLM_BASE_URL=
LLM_API_KEY=
# Адрес из инструкции организаторов: https://changellenge.up.railway.app/v1 (запасной: https://api.alfahack-gateway26.ru/v1)
LLM_MODEL_REASONING=z-ai/glm-5.3-flash
LLM_MODEL_FAST=deepseek/deepseek-v4.1-flash
LLM_DAILY_TOKEN_LIMIT=2000000
LLM_DAILY_COST_LIMIT=450
LLM_REASONING_EFFORT=low
LLM_FALLBACK_BASE_URL=https://api.alfahack-gateway26.ru/v1

# --- Данные кейса (пути на хосте). По умолчанию — синтетический набор из data/synthetic.
# CASE_DATA_DIR=./контекст/data
# BANK_PDF_HOST_DIR=./контекст/drive-download-20261021T181704Z-1-001

# --- Новости: RSS (имя|url через запятую), период обновления в минутах (0 — только по кнопке)
# RSS_SOURCES=Банк России|https://www.cbr.ru/rss/eventrss,Интерфакс|https://www.interfax.ru/rss.asp
RSS_REFRESH_MINUTES=0

# --- Прочее
FRONTEND_ORIGIN=http://localhost:3000
ANALYSIS_TIMEOUT_SECONDS=150
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
