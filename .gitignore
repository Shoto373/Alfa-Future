# Docs, images and temporary specs
*.docx
*.png
*.conf
# Конфигурации nginx (production и локальный стенд из 2 API) нужны compose; прочие *.conf (phone1.conf) — нет.
!/nginx/*.conf
extracted_spec.txt
generate_word_report.py
TZ_AND_PROMPTS_ALFA_PULSE.md

# Secrets and env (.env.example stays tracked)
.env
.env.*
*.env
!.env.example
*.pem
*.key

# Real data is never committed
/data/*
!/data/synthetic/
*.csv
!/data/synthetic/*.csv
*.pdf

# Node / Next.js
node_modules/
.npm-cache/
test-results/
playwright-report/
.next/
*.tsbuildinfo

# Hackathon context: task, bank research PDFs, client CSV data (never commit)
/контекст/

# Not needed on the server: local docs, agent notes, generators, e2e tools, legacy app
# contracts/ (контракт API) и infra/ (мониторинг, бэкапы) — часть репозитория; docs/ и THIRD_PARTY_NOTICES — только локально.
*.md
!/README.md
/docs/
/THIRD_PARTY_NOTICES
/tests/
/app/
/Dockerfile
/requirements.txt
/backend/scripts/*
# Оценка и калибровка ранжирования (SPR3-06) — в репозитории; остальные локальные скрипты — нет.
!/backend/scripts/_labels.py
!/backend/scripts/eval_ranking.py
!/backend/scripts/fit_ranking.py
.idea/

coverage/
