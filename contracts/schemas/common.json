{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alfa Pulse contract 1.0.0",
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "insight_id": {
          "title": "Insight Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "mode": {
          "enum": [
            "llm",
            "rules"
          ],
          "title": "Mode",
          "type": "string"
        },
        "refused": {
          "default": false,
          "title": "Refused",
          "type": "boolean"
        }
      },
      "required": [
        "insight_id",
        "question",
        "answer",
        "claims",
        "sources",
        "mode"
      ],
      "title": "Answer",
      "type": "object"
    },
    "BankView": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Summary"
        },
        "theses": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Theses",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        }
      },
      "required": [
        "available",
        "summary",
        "theses",
        "conflicts"
      ],
      "title": "BankView",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "origin": {
          "enum": [
            "fact",
            "client_data",
            "bank",
            "ai"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "features": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Features",
          "type": "array"
        }
      },
      "required": [
        "text",
        "origin",
        "source_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "request_id",
        "retryable"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "Feature": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "value"
      ],
      "title": "Feature",
      "type": "object"
    },
    "FeedbackRequest": {
      "additionalProperties": false,
      "properties": {
        "insight_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Insight Id",
          "type": "string"
        },
        "rating": {
          "enum": [
            1,
            -1
          ],
          "title": "Rating",
          "type": "integer"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "comment": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "owner",
                "ceo",
                "cfo",
                "accountant",
                "treasurer",
                "clevel"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "insight_id",
        "rating"
      ],
      "title": "FeedbackRequest",
      "type": "object"
    },
    "Insight": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "insight_id": {
          "title": "Insight Id",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "company_id": {
          "title": "Company Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "owner",
            "ceo",
            "cfo",
            "accountant",
            "treasurer",
            "clevel"
          ],
          "title": "Role",
          "type": "string"
        },
        "news_id": {
          "title": "News Id",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "mode": {
          "enum": [
            "llm",
            "rules"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "what_happened": {
          "$ref": "#/$defs/WhatHappened"
        },
        "why_important": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Why Important",
          "type": "array"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Risks",
          "type": "array"
        },
        "opportunities": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Opportunities",
          "type": "array"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Actions",
          "type": "array"
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "title": "Questions",
          "type": "array"
        },
        "bank_view": {
          "$ref": "#/$defs/BankView"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/ProductOffer"
          },
          "title": "Products",
          "type": "array"
        },
        "features_used": {
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "title": "Features Used",
          "type": "array"
        },
        "relevance": {
          "$ref": "#/$defs/Relevance"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/TraceStep"
          },
          "title": "Trace",
          "type": "array"
        },
        "disclaimer": {
          "title": "Disclaimer",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "insight_id",
        "request_id",
        "company_id",
        "role",
        "news_id",
        "created_at",
        "mode",
        "model",
        "title",
        "headline",
        "what_happened",
        "why_important",
        "risks",
        "opportunities",
        "actions",
        "questions",
        "bank_view",
        "products",
        "features_used",
        "relevance",
        "sources",
        "quality",
        "trace",
        "disclaimer"
      ],
      "title": "Insight",
      "type": "object"
    },
    "InsightRequest": {
      "additionalProperties": false,
      "properties": {
        "company_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Company Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "owner",
            "ceo",
            "cfo",
            "accountant",
            "treasurer",
            "clevel"
          ],
          "title": "Role",
          "type": "string"
        },
        "news_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "News Id",
          "type": "string"
        },
        "force_refresh": {
          "default": false,
          "title": "Force Refresh",
          "type": "boolean"
        }
      },
      "required": [
        "company_id",
        "role",
        "news_id"
      ],
      "title": "InsightRequest",
      "type": "object"
    },
    "NewsCreateRequest": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "NewsCreateRequest",
      "type": "object"
    },
    "ProductOffer": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "title",
        "text",
        "reason"
      ],
      "title": "ProductOffer",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/QualityCheck"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "passed",
        "attempts",
        "checks"
      ],
      "title": "Quality",
      "type": "object"
    },
    "QualityCheck": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "passed",
        "detail"
      ],
      "title": "QualityCheck",
      "type": "object"
    },
    "QuestionRequest": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 1000,
          "minLength": 2,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "QuestionRequest",
      "type": "object"
    },
    "Relevance": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "title": "Score",
          "type": "number"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/RelevanceReason"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "score",
        "reasons"
      ],
      "title": "Relevance",
      "type": "object"
    },
    "RelevanceReason": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        }
      },
      "required": [
        "kind",
        "feature",
        "origin",
        "weight",
        "text"
      ],
      "title": "RelevanceReason",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "news",
            "bank_analytics",
            "client_data",
            "bank_product"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Id"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        }
      },
      "required": [
        "source_id",
        "kind",
        "title"
      ],
      "title": "Source",
      "type": "object"
    },
    "TraceStep": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "title": "Step",
          "type": "integer"
        },
        "stage": {
          "enum": [
            "plan",
            "tool",
            "compose",
            "check",
            "adapt",
            "finalize"
          ],
          "title": "Stage",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "warning",
            "error",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "number"
        },
        "output": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        }
      },
      "required": [
        "step",
        "stage",
        "name",
        "detail",
        "status",
        "duration_ms"
      ],
      "title": "TraceStep",
      "type": "object"
    },
    "WhatHappened": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Facts",
          "type": "array"
        },
        "actors": {
          "items": {
            "type": "string"
          },
          "title": "Actors",
          "type": "array"
        },
        "dates": {
          "items": {
            "type": "string"
          },
          "title": "Dates",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "facts",
        "actors",
        "dates",
        "assumptions"
      ],
      "title": "WhatHappened",
      "type": "object"
    }
  }
}
